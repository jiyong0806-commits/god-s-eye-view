{
  "name": "gods-eye-view",
  "private": true,
  "version": "0.1.1",
  "description": "A real-time intelligence console for planet Earth — photorealistic 3D globe, live aircraft/ships/satellites/earthquakes/CCTV, and hands-free voice control. Runs in a browser.",
  "type": "module",
  "license": "MIT",
  "author": "Bilawal Sidhu",
  "homepage": "https://github.com/bilawalsidhu/gods-eye-view#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bilawalsidhu/gods-eye-view.git"
  },
  "bugs": {
    "url": "https://github.com/bilawalsidhu/gods-eye-view/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cesium",
    "3d-globe",
    "geospatial",
    "osint",
    "spatial-intelligence",
    "photorealistic-3d-tiles",
    "adsb",
    "ais",
    "satellites",
    "voice-control",
    "openai-realtime",
    "visualization"
  ],
  "scripts": {
    "doctor": "node scripts/setup-doctor.mjs",
    "dev": "vite --host 0.0.0.0 --port 5000",
    "dev:local": "vite --host 127.0.0.1 --port 5000",
    "dev:mobile": "vite --host 0.0.0.0 --port 6000 --open /mobile.html",
    "dev:secure": "./scripts/dev-secure.sh",
    "opensky:import": "./scripts/opensky-import-client.sh",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "npm run build && node scripts/prepare-pages-build.mjs",
    "build:flow": "node scripts/build-flow.mjs",
    "build:event": "node scripts/build-event.mjs",
    "deploy:pages": "npx wrangler@4.136.3 pages deploy dist/pages --config wrangler.pages.jsonc --project-name godseyeview --branch main",
    "package:sites": "node scripts/package-sites-clean.mjs",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "test:flow": "node --test packages/god-flow/graph.test.mjs packages/god-mcp/server.test.mjs worker/flowRoutes.test.mjs",
    "mcp": "node packages/god-mcp/server.mjs",
    "test:track": "node scripts/track-regression.mjs",
    "qa:map-source-tray": "node scripts/qa-map-source-tray.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@xyflow/react": "12.11.6",
    "cesium": "^1.124.0",
    "egm96-universal": "^1.1.1",
    "lucide-react": "1.47.0",
    "mgrs": "^2.1.0",
    "pbf": "^5.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satellite.js": "^6.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "puppeteer": "^25.12.0",
    "sharp": "^0.35.4",
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23",
    "ws": "^8.21.0"
  }
}
